# Binance API Configuration
# Copy this file to .env.local and add your actual API credentials

# Get these from your Binance account:
# 1. Go to https://www.binance.com/en/my/settings/api-management
# 2. Create new API key with "Enable Reading" permission only
# 3. Copy the API Key and Secret Key below

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# SECURITY NOTES:
# - Never commit .env.local to git (it's in .gitignore)
# - Only enable "Enable Reading" permission on your API key
# - Never enable trading permissions for this screener
# - Keep your secret key private and secure